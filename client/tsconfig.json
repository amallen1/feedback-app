{
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "jsx": "react-jsx",
    "allowJs": true,
    "noEmit": true,
    "isolatedModules": true, 
    "lib": ["esnext", "dom", "dom.iterable", "es2020"], 
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "types": ["vite/client"], 
  },
  "include": ["src"],
  "exclude": ["node_modules"]
}
